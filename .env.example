# =====================================================================
# Nexus Core Meta Trading V4 — environment template
# Copy to .env and fill in. NEVER commit the real .env.
# =====================================================================

# ---- MetaTrader 5 ----
# Leave MT5_LOGIN/PASSWORD/SERVER empty to reuse the account already
# logged in inside the running MT5 terminal (recommended for first run).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: full path to terminal64.exe if auto-detect fails, e.g.
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TERMINAL_PATH=

# ---- TimescaleDB (matches docker-compose.yml) ----
# NOTE: host ports are 5544 / 6644 on purpose — the Alpaca edition's
# containers (nexus_timescaledb / nexus_qdrant) already own 5432 / 6333.
DB_HOST=localhost
DB_PORT=5544
DB_NAME=nexus_mt5
DB_USER=nexus
DB_PASSWORD=change_me_strong_password

# ---- Qdrant vector memory ----
QDRANT_HOST=localhost
QDRANT_PORT=6644
# QDRANT_URL=            # optional: use a remote/cloud Qdrant instead
# QDRANT_API_KEY=

# ---- Telegram alerts ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- News sentiment (Phase 6) ----
NEWSAPI_KEY=

# ---- Universe ----
# manual  = trade exactly what is in config watchlists that exists at broker
# auto    = rank pools by spread/liquidity and pick TOP_N per class
UNIVERSE_MODE=manual
TOP_N_SYMBOLS=6

# ---- Safety ----
# true  = order placement functions REFUSE to send (paper/journal only)
# false = live orders allowed. Keep true until backtests + demo are green.
DRY_RUN=true
